# ===== Forja Studio — configuração =====
APP_NAME="Forja Studio"
ENVIRONMENT=production
HTTP_PORT=8080

# Gere com: openssl rand -hex 32
SECRET_KEY=troque-por-um-valor-aleatorio-longo
ACCESS_TOKEN_EXPIRE_MINUTES=720
ALLOW_REGISTRATION=true
CORS_ORIGINS=http://localhost:8080

# Administrador criado automaticamente na primeira inicialização
ADMIN_EMAIL=admin@suaempresa.com.br
ADMIN_PASSWORD=TroqueEstaSenha123

# Banco de dados
POSTGRES_USER=forja
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=forja

# Pastas no host
MODELS_PATH=./models
COMFYUI_MODELS_PATH=./models/comfyui

# Processamento
WORKER_CONCURRENCY=2
API_WORKERS=2
RENDER_SOFT_TIME_LIMIT=3600
RENDER_MAX_RETRIES=2

# Limites de upload (MB) e cota padrão por usuário
MAX_IMAGE_UPLOAD_MB=15
MAX_AUDIO_UPLOAD_MB=40
USER_QUOTA_MB=5120

# IA — roteiros (Ollama). Use o perfil "ollama" ou aponte para um Ollama externo.
LLM_PROVIDER=ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# IA — imagens: auto | comfyui | pexels | procedural
IMAGE_PROVIDER=auto
COMFYUI_URL=http://comfyui:8188
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
COMFYUI_TORCH_VARIANT=cpu
# Chave gratuita em https://www.pexels.com/api/ (fotos reais com licença livre p/ uso comercial)
PEXELS_API_KEY=

# IA — voz: kokoro | piper | espeak
TTS_PROVIDER=kokoro
